# Device
CONFIG_MACH_XIAOMI_SURYA=y

# Ramoops
CONFIG_CMDLINE="cgroup_disable=pressure ramoops_memreserve=4M"

# Touchscreen
CONFIG_TOUCHSCREEN_COMMON=y
CONFIG_TOUCHSCREEN_PROPERTIES=y
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_FPC1020=y
CONFIG_FINGERPRINT_GF3208=y